(eval-when (:compile-toplevel :load-toplevel :execute)
  (require :zk-test))

(defpackage #:zk-sexp-edit.tests
  (:use #:cl #:zk-test)
  (:export #:all))
(in-package #:zk-sexp-edit.tests)

(defun source (text)
  (zk-syntax:parse-source text))

(defun changed (text function anchor &rest options)
  (apply #'zk-sexp-edit:edit-text function text anchor options))

(deftest operation-families ()
  (is-equal "(a (b) c)" (changed "(a b c)" #'zk-sexp-edit:wrap 3))
  (is-equal "a b c" (changed "(a b c)" #'zk-sexp-edit:splice 3))
  (is-equal "(b c)" (changed "(a (b c) d)" #'zk-sexp-edit:raise 3 :head 8))
  (is-equal "(a b c)" (changed "(a b) c" #'zk-sexp-edit:slurp 3))
  (is-equal "(a b c)" (changed "a (b c)" #'zk-sexp-edit:slurp 3 :direction :backward))
  (is-equal "(a b) c" (changed "(a b c)" #'zk-sexp-edit:barf 3))
  (is-equal "a (b c)" (changed "(a b c)" #'zk-sexp-edit:barf 3 :direction :backward))
  (is-equal "(a) (b)" (changed "(a b)" #'zk-sexp-edit:split 2))
  (is-equal "(a b)" (changed "(a) (b)" #'zk-sexp-edit:join 1))
  (is-equal "(a b)" (changed "(a) (b)" #'zk-sexp-edit:join 5 :direction :backward))
  (is-equal "b a c" (changed "a b c" #'zk-sexp-edit:transpose 0))
  (is-equal "b a c" (changed "a b c" #'zk-sexp-edit:transpose 2 :direction :backward)))

(deftest direction-errors ()
  (let ((snapshot (source "(a) b")))
    (signals error (zk-sexp-edit:slurp snapshot 1 :direction :sideways))
    (signals error (zk-sexp-edit:wrap snapshot 1 :direction :forward))))

(deftest reversed-selection-and-application-values ()
  (let* ((snapshot (source "a b"))
         (edit (zk-sexp-edit:wrap snapshot 3 :head 0)))
    (is-values (zk-sexp-edit:apply-edit edit) "(a b)" 4 1)
    (is-equal "a b" (zk-syntax:text snapshot))
    (is (zk-syntax:snapshot-equal-p snapshot (zk-syntax:edit-source edit)))))

(deftest edit-text-forwards-the-selection-and-direction ()
  (is-values (zk-sexp-edit:edit-text #'zk-sexp-edit:transpose "雪 a b" 7
                                    :head 4 :direction :backward)
             "a b 雪" 3 0))

(deftest text-commands-can-reuse-a-snapshot-and-its-readtable ()
  (let* ((snapshot (zk-syntax:parse-source "#>hello" :readtable :raw-strings))
         (edit (zk-sexp-edit:delete-form snapshot 2)))
    (is-eq :raw-string (zk-syntax:kind (zk-sexp-edit:form-at snapshot 2)))
    (is (zk-sexp-edit:editp edit))
    (is-values (zk-sexp-edit:apply-edit edit snapshot) "" 0 0)
    (is-values (zk-sexp-edit:edit-text #'zk-sexp-edit:delete-form snapshot 2) "" 0 0))
  (let* ((snapshot (source "a"))
         (same-text (source "a"))
         (edit (zk-sexp-edit:wrap snapshot 0)))
    (let ((condition (signals zk-sexp-edit:edit-error
                       (zk-sexp-edit:apply-edit edit same-text))))
      (is-eq :stale-snapshot (zk-sexp-edit:edit-error-reason condition)))
    (let ((condition (signals zk-sexp-edit:edit-error
                       (zk-sexp-edit:edit-text (lambda (source anchor)
                                                (declare (ignore source anchor))
                                                edit)
                                              same-text 0))))
      (is-eq :stale-snapshot (zk-sexp-edit:edit-error-reason condition)))))

(deftest delete-the-local-form ()
  (is-values (zk-sexp-edit:edit-text #'zk-sexp-edit:delete-form "'雪 tail" 1)
             " tail" 0 0)
  (is-equal "a c" (changed "a(b)c" #'zk-sexp-edit:delete-form 1))
  (let* ((text (format nil "(a) ;stay~% b"))
         (condition (signals zk-sexp-edit:edit-error
                      (changed text #'zk-sexp-edit:delete-form 6))))
    (is-eq :no-form (zk-sexp-edit:edit-error-reason condition)))
  (let ((condition (signals zk-sexp-edit:edit-error
                     (changed "#+flag value" #'zk-sexp-edit:delete-form 3))))
    (is-eq :unsafe-token-boundary (zk-sexp-edit:edit-error-reason condition))))

(deftest document-application-is-atomic-and-stale-safe ()
  (let* ((workspace (zk-syntax:make-workspace))
         (snapshot (zk-syntax:set-document workspace "input" "a"))
         (edit (zk-sexp-edit:wrap snapshot 0 :head 1)))
    (multiple-value-bind (result anchor head)
        (zk-sexp-edit:apply-edit-to-document workspace "input" edit)
      (is-equal "(a)" (zk-syntax:text result))
      (is= 1 anchor)
      (is= 2 head)
      (is (zk-syntax:snapshot-equal-p result (zk-syntax:snapshot workspace "input"))))
    (signals error (zk-sexp-edit:apply-edit-to-document workspace "input" edit))
    (is-equal "(a)" (zk-syntax:text (zk-syntax:snapshot workspace "input"))))
  (let* ((snapshot (source "a"))
         (edit (zk-sexp-edit:wrap snapshot 0))
         (other (zk-syntax:make-workspace)))
    (zk-syntax:set-document other "input" "a")
    (let ((condition (signals zk-syntax:edit-error
                       (zk-sexp-edit:apply-edit-to-document other "input" edit))))
      (is-eq :stale-snapshot (zk-syntax:edit-error-reason condition)))))

(deftest form-at-is-local-and-keeps-reader-prefixes ()
  (let ((snapshot (source "'a #'(f x) #+snow (g y)")))
    (is-equal "'a" (zk-syntax:node-text (zk-sexp-edit:form-at snapshot 1)))
    (is-equal "#'(f x)" (zk-syntax:node-text (zk-sexp-edit:form-at snapshot 5)))
    (is-equal "f" (zk-syntax:node-text (zk-sexp-edit:form-at snapshot 6)))
    (is-equal "#+snow (g y)" (zk-syntax:node-text (zk-sexp-edit:form-at snapshot 18)))
    (is-equal "g" (zk-syntax:node-text (zk-sexp-edit:form-at snapshot 19)))
    (is-equal "snow" (zk-syntax:node-text (zk-sexp-edit:form-at snapshot 13)))
    (is (null (zk-sexp-edit:form-at snapshot 2))))
  (let ((snapshot (source "#+(and a b) body")))
    (is-equal "(and a b)" (zk-syntax:node-text (zk-sexp-edit:form-at snapshot 2)))
    (is-equal "#+(and a b) body"
              (zk-syntax:node-text (zk-sexp-edit:form-at snapshot 12)))))

(deftest trivia-characters-and-incomplete-input ()
  (let* ((text (format nil "a ; (comment)~% #| ( #| ) |# |# #\\) (open"))
         (snapshot (source text)))
    (is (null (zk-sexp-edit:form-at snapshot 3)))
    (is (null (zk-sexp-edit:form-at snapshot (+ 2 (search "#|" text)))))
    (is-equal "#\\)" (zk-syntax:node-text (zk-sexp-edit:form-at snapshot (search "#\\)" text))))
    (is-equal "(open" (zk-syntax:node-text (zk-sexp-edit:form-at snapshot (search "(open" text)))))
  (is (null (zk-sexp-edit:form-at (source "") 0)))
  (is-equal "'((a) b)" (changed "'(a b)" #'zk-sexp-edit:wrap 2))
  (is-equal "(x a b" (changed "x (a b" #'zk-sexp-edit:slurp 3 :direction :backward)))

(deftest selection-query-direction-and-expansion ()
  (let ((snapshot (source "(a (b c))")))
    (is-values (zk-sexp-edit:select-form snapshot 4) 4 5)
    (is-values (zk-sexp-edit:select-form snapshot 5 :head 4) 5 4)
    (is-values (zk-sexp-edit:select-form snapshot 7 :head 4) 8 3)
    (is-values (zk-sexp-edit:expand-selection snapshot 5 :head 4) 8 3)
    (is-values (zk-sexp-edit:expand-selection snapshot 8 :head 3) 9 0)
    (is-values (zk-sexp-edit:expand-selection snapshot 9 :head 0) 9 0))
  (is-values (zk-sexp-edit:select-form (source " ;comment") 0) nil nil)
  (is-values (zk-sexp-edit:expand-selection (source "") 0) 0 0))

(deftest unicode-positions-and-custom-command ()
  (let* ((snapshot (source "雪 a"))
         (byte (zk-syntax:byte-offset snapshot 2)))
    (is= 4 byte)
    (is-values (zk-sexp-edit:select-form snapshot 3 :head 0) 3 0)
    (is-equal "雪 (a)" (zk-sexp-edit:apply-edit (zk-sexp-edit:wrap snapshot byte)))
    (signals error (zk-sexp-edit:form-at snapshot 1))
    (signals error (zk-sexp-edit:select-form snapshot 0 :head 1)))
  (let* ((snapshot (source "a 雪 b"))
         (edit (zk-syntax:make-edit snapshot '((2 5 "犬猫")) 8 2)))
    (is-values (zk-sexp-edit:apply-edit edit) "a 犬猫 b" 8 2)))

(deftest safety-and-trivia-preservation ()
  (is-equal "foo bar" (changed "(foo)bar" #'zk-sexp-edit:splice 1))
  (is-equal "() a" (changed "(a)" #'zk-sexp-edit:barf 1))
  (is-equal (format nil "(a) ;stay~% (b)")
            (changed (format nil "(a ;stay~% b)") #'zk-sexp-edit:split 2))
  (is-equal "#+snow (a b)" (changed "#+snow (a) b" #'zk-sexp-edit:slurp 8))
  (signals error (changed "(a . b) c" #'zk-sexp-edit:slurp 1))
  (signals error (changed "(a" #'zk-sexp-edit:slurp 1))
  (signals error (changed "(a) #(b)" #'zk-sexp-edit:join 1)))

(deftest typing-and-deletion-in-one-document ()
  (let* ((workspace (zk-syntax:make-workspace))
         (snapshot (zk-syntax:set-document workspace "input" "(print )")))
    (multiple-value-bind (next anchor head)
        (zk-sexp-edit:apply-edit-to-document workspace "input"
                                             (zk-sexp-edit:insert-delimiter snapshot 7 #\"))
      (is-equal "(print \"\")" (zk-syntax:text next))
      (is= 8 anchor)
      (is= anchor head)
      (let ((skip (zk-sexp-edit:insert-delimiter next head #\")))
        (is (null (zk-sexp-edit:edit-changes skip)))
        (is-values (zk-sexp-edit:edit-selection skip) 9 9)
        (is (zk-syntax:snapshot-equal-p
             next (zk-sexp-edit:apply-edit-to-document workspace "input" skip))))
      (is-values (zk-sexp-edit:apply-edit (zk-sexp-edit:delete-backward next head))
                 "(print )" 7 7)))
  (let ((condition (signals zk-sexp-edit:edit-error
                     (changed "'a b" #'zk-sexp-edit:delete-forward 1))))
    (is-eq :unsafe-token-boundary (zk-sexp-edit:edit-error-reason condition))))

(deftest navigate-and-delete-a-whole-form ()
  (let* ((snapshot (source "(f #'(g 雪) x)"))
         (end (zk-sexp-edit:forward-form snapshot 3)))
    (is= 12 end)
    (is= 3 (zk-sexp-edit:backward-form snapshot end))
    (is= 6 (zk-sexp-edit:down-list snapshot 3))
    (is= 12 (zk-sexp-edit:up-list snapshot 6))
    (is= 5 (zk-sexp-edit:up-list snapshot 6 :direction :backward))
    (is (null (zk-sexp-edit:forward-form snapshot 11)))
    (is-values (zk-sexp-edit:apply-edit (zk-sexp-edit:delete-forward snapshot 3 :head end))
               "(f  x)" 3 3)))

(deftest indent-and-infer-parens-are-explicit-edits ()
  (let* ((text (format nil "(defun f ()~% (work))"))
         (snapshot (source text)))
    (is-values (zk-sexp-edit:apply-edit (zk-sexp-edit:indent snapshot 13))
               (format nil "(defun f ()~%  (work))") 14 14))
  (let* ((text (format nil "(f~%  a)~%  b"))
         (snapshot (source text)))
    (is-values (zk-sexp-edit:apply-edit (zk-sexp-edit:infer-parens snapshot (length text)))
               (format nil "(f~%  a~%  b)") (1- (length text)) (1- (length text)))))

(deftest host-can-use-source-edits-without-a-workspace ()
  (let* ((text "(f 雪) tail")
         (snapshot (zk-syntax:parse-source text))
         (edit (zk-sexp-edit:slurp snapshot 3)))
    (is-equal '((6 7 "") (12 12 ")")) (zk-sexp-edit:edit-changes edit))
    (is-values (zk-sexp-edit:apply-edit edit) "(f 雪 tail)" 3 3)
    (is (not (zk-syntax:snapshot-equal-p snapshot (zk-syntax:parse-source text)))))
  (let ((snapshot (zk-syntax:parse-source "#>hello" :readtable :raw-strings)))
    (is-eq :raw-string (zk-syntax:kind (zk-syntax:node-at snapshot 0)))))

(defsuite all
  operation-families direction-errors reversed-selection-and-application-values
  edit-text-forwards-the-selection-and-direction text-commands-can-reuse-a-snapshot-and-its-readtable
  delete-the-local-form
  document-application-is-atomic-and-stale-safe form-at-is-local-and-keeps-reader-prefixes
  trivia-characters-and-incomplete-input selection-query-direction-and-expansion
  unicode-positions-and-custom-command safety-and-trivia-preservation
  typing-and-deletion-in-one-document navigate-and-delete-a-whole-form
  indent-and-infer-parens-are-explicit-edits host-can-use-source-edits-without-a-workspace)
